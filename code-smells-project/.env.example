# Chave de assinatura de sessões/tokens. OBRIGATÓRIA — a aplicação não sobe sem ela.
# Gere uma chave aleatória, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Caminho do arquivo SQLite (default: loja.db)
DATABASE_PATH=loja.db

# Host/porta do servidor (defaults: 127.0.0.1 / 5000).
# No macOS a porta 5000 costuma estar ocupada pelo AirPlay Receiver — use PORT=5055, por exemplo.
HOST=127.0.0.1
PORT=5000

# Debug do Flask: 1 habilita (NUNCA em produção — expõe o debugger interativo). Default: 0.
FLASK_DEBUG=0

# Origens permitidas para CORS, separadas por vírgula. Vazio = CORS desabilitado.
# Ex.: CORS_ORIGINS=https://app.minhaloja.com,https://admin.minhaloja.com
CORS_ORIGINS=
