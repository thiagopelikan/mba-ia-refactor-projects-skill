# Copie para .env e preencha. NUNCA commite o .env com valores reais.

# HTTP
PORT=3000
JSON_BODY_LIMIT=100kb
LOG_LEVEL=info

# Banco (sqlite). ':memory:' recria o banco com seed a cada boot.
DATABASE_STORAGE=:memory:
# Reservados para um banco com autenticação (não usados pelo sqlite em memória).
DB_USER=
DB_PASS=

# Gateway de pagamento (chave secreta — jamais no código ou em logs)
PAYMENT_GATEWAY_KEY=

# SMTP (notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Auth: infra pronta, desligada por padrão para preservar o contrato do baseline.
# ENFORCE_AUTH=1 passa a exigir Bearer token em /api/admin/* e DELETE /api/users/:id.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600
ENFORCE_AUTH=0

# Senha do usuário seed (se vazio, gera uma senha aleatória a cada boot; só o hash é gravado)
SEED_USER_PASSWORD=

# Custo do bcrypt
BCRYPT_COST=10
