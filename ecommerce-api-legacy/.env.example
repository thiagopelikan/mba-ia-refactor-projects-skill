# Copie para .env e preencha. NUNCA commite o .env com valores reais.

# HTTP
PORT=3000
JSON_BODY_LIMIT=100kb
LOG_LEVEL=info

# Banco (sqlite). ':memory:' recria o banco com seed a cada boot.
DATABASE_STORAGE=:memory:
# Reservados para um banco com autenticação (não usados pelo sqlite em memória).
DB_USER=
DB_PASS=

# Gateway de pagamento (chave secreta — jamais no código ou em logs)
PAYMENT_GATEWAY_KEY=

# SMTP (notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Auth: SEMPRE ligada — /api/admin/* e DELETE /api/users/:id exigem
# "Authorization: Bearer <token>" (401 sem token). Não há flag para desligar.
# Token obtido em POST /api/login {email, password}.
# AUTH_TOKEN_SECRET vazio → secret efêmero por boot (tokens não sobrevivem a restart).
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# Senha do usuário seed (leonan@fullcycle.com.br). Se vazio, gera uma senha
# aleatória a cada boot (só o hash é gravado) e o login do seed fica indisponível.
# Defina um valor para poder testar POST /api/login com o usuário seed.
SEED_USER_PASSWORD=

# Custo do bcrypt
BCRYPT_COST=10
