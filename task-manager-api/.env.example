# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versione o `.env` real.

# OBRIGATÓRIA — a aplicação não sobe sem ela.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# String de conexão do SQLAlchemy (default: sqlite:///tasks.db no instance/ do Flask)
DATABASE_URI=sqlite:///tasks.db

# 1 liga o modo debug do Flask (NUNCA em produção)
FLASK_DEBUG=0

# Interface e porta do servidor de desenvolvimento
HOST=127.0.0.1
PORT=5000

# Origens permitidas no CORS, separadas por vírgula (ou * para liberar tudo)
CORS_ORIGINS=*

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Validade em segundos dos tokens emitidos pelo /login (default: 8h)
AUTH_TOKEN_MAX_AGE_SECONDS=28800

# Senha usada pelos usuários do seed.py; se vazio, o seed gera senhas
# aleatórias e as imprime uma única vez no console.
SEED_DEFAULT_PASSWORD=
